# Copy to .env.local. Everything is optional: the site builds and runs with
# nothing set (leads are logged server-side, the Knowledge Hub uses the seed).

# Public URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://anjanprasad.com

# Supabase — stores leads and newsletter subscriptions (supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity — Knowledge Hub content (sanity.config.ts, npm run studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Resend — notification + auto-reply emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Anjan Prasad <hello@anjanprasad.com>"
NOTIFY_ADMIN_EMAIL=performance@noboruworld.com
