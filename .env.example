# Copy to .env.local. Everything is optional: the site builds and runs with
# nothing set (leads are logged server-side, the Knowledge Hub uses the seed).

# Public URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://anjanprasad.com

# Supabase — stores leads and newsletter subscriptions (supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity — Knowledge Hub content (sanity.config.ts, npm run studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Email — notifications + auto-replies. Easiest: Gmail SMTP with an App
# Password (myaccount.google.com/apppasswords). If SMTP_USER/SMTP_PASS are
# set they are used; otherwise Resend (RESEND_API_KEY) if set; otherwise
# emails are skipped and leads are still stored/logged.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Resend (alternative transport, needs a verified domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Anjan Prasad <hello@anjanprasad.com>"
# Comma-separated: every address gets each lead notification
NOTIFY_ADMIN_EMAIL=performance@noboruworld.com
